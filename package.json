{
  "name": "larkit",
  "version": "0.1.1",
  "description": "飞书全栈真相引擎与一站式 Agent 开发工具包（MCP Server + CLI）",
  "type": "module",
  "bin": {
    "larkit": "./bin/larkit.js",
    "larkit-mcp": "./bin/larkit-mcp.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "skills/",
    "verified_truths/",
    "AGENT_SKILL.md",
    "README.md",
    "larkit.config.example.json",
    "workers/"
  ],
  "scripts": {
    "bootstrap": "node bin/larkit.js init",
    "status": "node bin/larkit.js status",
    "index": "node scripts/build-index.mjs",
    "index:extract": "node scripts/build-index.mjs --only=extract",
    "index:format": "node scripts/build-index.mjs --only=format",
    "index:db": "node scripts/build-index.mjs --only=db",
    "verify": "node scripts/verify-index.mjs && node scripts/verify-mcp.mjs",
    "verify:index": "node scripts/verify-index.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "verify:bootstrap": "node scripts/verify-bootstrap.mjs",
    "pack:truth": "node bin/larkit.js pack build --tag=$(node -p \"require('./package.json').version\")",
    "pack:publish": "node scripts/publish-pack.mjs",
    "search": "node bin/larkit.js search",
    "inspect": "node bin/larkit.js inspect",
    "doctor": "node bin/larkit.js doctor",
    "mcp": "node bin/larkit-mcp.js",
    "check": "node scripts/check-syntax.mjs",
    "verify:console": "node scripts/verify-console.mjs"
  },
  "dependencies": {
    "@electron/asar": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "js-beautify": "^2.0.3",
    "prettier": "^3.10.1",
    "protobufjs": "^8.8.1",
    "puppeteer-core": "^24.39.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "feishu",
    "lark",
    "mcp",
    "agent",
    "cli",
    "reverse-engineering",
    "openapi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztxtxwd/larkit.git"
  },
  "homepage": "https://github.com/ztxtxwd/larkit#readme",
  "bugs": {
    "url": "https://github.com/ztxtxwd/larkit/issues"
  },
  "license": "UNLICENSED"
}
